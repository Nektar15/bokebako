# 静的解析（CODING_RULES 5章）：レベル6でエラー0件にする
# 実行：vendor/bin/phpstan analyse
parameters:
    level: 6
    paths:
        - app
        - tests
    excludePaths:
        - app/Views/*
        - app/Config/*
    scanDirectories:
        - system
    bootstrapFiles:
        - system/Test/bootstrap.php
    # ENVIRONMENT は bootstrap で 'testing' に固定されるが、実際は .env で変わる。
    # 値で判定されると「常に false」と誤検知されるので、動的な定数として扱う
    dynamicConstantNames:
        - ENVIRONMENT
