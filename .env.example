#--------------------------------------------------------------------
# ぼけばこ 環境設定の見本
# コピーして .env を作る。.env はコミットしない。項目を増やしたらこのファイルにも足す。
#--------------------------------------------------------------------

# development | staging | production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# アプリ
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
# 本番では true（http でのアクセスを https に向け、HSTS ヘッダーを出す。.htaccess のリダイレクトと二重でよい）
app.forceGlobalSecureRequests = false
# 管理画面のパス（推測困難な値にする。例：mgmt-7k2p）
app.adminPath = 'admin'
# 静的資産のキャッシュ用バージョン。デプロイごとに変える（空ならファイル更新時刻を使う）
app.assetVersion = ''
# GA4 測定ID（空なら出力しない）
app.ga4Id = ''
# 開催者トークン・IP・ブラウザIDをハッシュ化するときの秘密鍵（32文字以上のランダム文字列）
app.hashSecret = ''
# 管理者への通知メール（NGワード要確認・通報の自動非表示・お問い合わせ）。空なら送らない
app.adminEmail = ''

# 画面一覧ナビ（確認用。画面の上部に全画面へのプルダウンを出す。本番では false のまま。ADR 0009）
screennav.enabled = false

# 管理画面（ログイン画面を含む）にアクセスできる IP（カンマ区切り）。空なら IP では制限しない（SPEC 3.4「任意」）
ADMIN_ALLOWED_IPS = ''
# 本番では true（ログインのセッション Cookie を https のときだけ送る）
cookie.secure = false

#--------------------------------------------------------------------
# データベース（MariaDB 10.5）
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = bokebako
database.default.username = bokebako
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
# TLS 必須の外部 DB だけ CA 証明書のパスを書く（Vercel の仮置き。本番の Xserver では空のまま。ADR 0015）
# database.default.sslCA =

#--------------------------------------------------------------------
# 外部サービス（工程4で使う）
#--------------------------------------------------------------------
# OpenAI（GPT-5 nano）。S-05 AI補助判定
openai.apiKey = ''
openai.model = 'gpt-5-nano'

# OGP 画像（S-07）に使う日本語フォント。空なら writable/fonts/NotoSansJP-Bold.ttf（README）
ogp.font = ''
# CAPTCHA（未確定事項3。サービス確定後にキー名を直す）
captcha.siteKey = ''
captcha.secretKey = ''
# 管理者への通知メール（宛先は app.adminEmail）。差出人が空だと送られない
email.fromEmail = ''
email.fromName = 'ぼけばこ'
# Xserver の SMTP を使うとき（使わなければ PHP の mail()）
# email.protocol = 'smtp'
# email.SMTPHost = ''
# email.SMTPUser = ''
# email.SMTPPass = ''
# email.SMTPPort = 587
# email.SMTPCrypto = 'tls'
